# Copy this file to .env.local (development) or set the same names in your host's dashboard (production).

# Where the Spring Boot API lives.
# Leave it empty in development: Vite forwards /api to http://localhost:8080.
# In production set the full address, for example: https://your-backend.onrender.com/api
VITE_API_URL=

# Name shown in the header, footer and page title.
VITE_STORE_NAME=ShopNest
